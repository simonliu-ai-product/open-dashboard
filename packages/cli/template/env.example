# Copy to .env (git-ignored) and reference from open-dashboard.config.ts.
# Prefer a read-only database user — /connect-database gives the grant per engine.
# APP_DATABASE_URL=postgres://reader:password@localhost:5432/app
# SHOP_MYSQL_URL=mysql://reader:password@localhost:3306/shop
# ERP_MSSQL_URL=mssql://reader:password@localhost:1433/erp?encrypt=true
# ORACLE_URL=oracle://reader:password@localhost:1521/ORCLPDB1
# CLICKHOUSE_URL=https://reader:password@host:8443/default
# SNOWFLAKE_ACCOUNT=myorg-myaccount
# SNOWFLAKE_USER=reader
# SNOWFLAKE_PASSWORD=

# Optional chat assistant on dashboard pages (off unless set in open-dashboard.config.ts):
#   assistant: { provider: 'gemini', model: process.env.ASSISTANT_MODEL ?? '', apiKey: process.env.GEMINI_API_KEY,
#                reasoningEffort: process.env.ASSISTANT_REASONING_EFFORT }
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ASSISTANT_MODEL=
# How long it thinks before answering: low (a few seconds) | medium (default for Gemini) | high
# ASSISTANT_REASONING_EFFORT=
