{
  "name": "@open-dashboard/cli",
  "version": "0.6.0",
  "description": "Scaffolder for open-dashboard — describe a dashboard to your agent, get a live one over your database.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonliu-ai-product/open-dashboard.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/simonliu-ai-product/open-dashboard#readme",
  "bugs": {
    "url": "https://github.com/simonliu-ai-product/open-dashboard/issues"
  },
  "keywords": [
    "dashboard",
    "sql",
    "agent",
    "claude-code",
    "scaffold",
    "create"
